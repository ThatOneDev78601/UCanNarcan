rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() { return request.auth != null && request.auth.token.admin == true; }
  match /locations/{id} { allow read: if resource.data.published == true || admin(); allow write: if admin(); }
  match /{document=**} { allow read, write: if false; }
 }
}
